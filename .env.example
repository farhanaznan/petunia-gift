# Neon Postgres (local next dev / drizzle-kit). On Cloudflare Workers use Hyperdrive binding.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# iron-session password — min 32 characters
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Public app URL (Workers / preview)
APP_URL=http://localhost:3000

# Seed admin (used by future seed script — do not commit real secrets)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me-to-a-strong-password

# Cloudflare R2 — S3-compatible API for browser presigned PUT/GET.
# Prefer MEDIA_BUCKET Workers binding for server-side put/get in production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=petunia-gift-media

# Optional local Hyperdrive override already in wrangler.jsonc localConnectionString.
# Cloudflare dashboard: create Hyperdrive pointing at Neon, paste id into wrangler.jsonc.
