# Neon Postgres (local next dev / drizzle-kit / seed). On Workers prefer Hyperdrive binding;
# you may also set DATABASE_URL as a Worker secret for a temporary bridge.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# iron-session password — min 32 characters (required for real staging)
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Public app URL (Workers / preview)
APP_URL=http://localhost:3000

# First admin seed (npm run db:seed-admin, or "Seed first admin from env" on /admin/login)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me-to-a-strong-password

# Cloudflare R2 — S3-compatible API for browser presigned PUT/GET.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=petunia-gift-media
