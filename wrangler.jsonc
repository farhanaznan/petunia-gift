{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "petunia-gift",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // Shell-only staging: Hyperdrive + R2 omitted so placeholders don't block deploy.
  // Full soft-launch (Neon + media) — restore bindings like:
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<HYPERDRIVE_ID>", "localConnectionString": "postgresql://..." }],
  // "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "petunia-gift-media" }]
}
